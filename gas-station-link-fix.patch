+// ---------- Foursquare Places API (nearby-station lookup) ----------
+// Same unverified-contract caveat as restaurant-deals.js's copy of this
+// function (see its header comment for the full explanation) — Foursquare
+// is mid-migration onto a new Places API and the shape below is confirmed
+// against one working example, not their reference docs directly. Any
+// unexpected shape/failure just returns null, never throws.
+//
+// Purpose: findOfficialStationPage below only ever finds the CHAIN's own
+// national homepage/pricing page (e.g. "site:shell.com") — that's a real
+// domain, but it's not a station near this person, and it very often finds
+// nothing at all (chains rarely publish per-station price pages), which
+// previously left `url` falling all the way back to best.url — the
+// aggregator/blog/news ARTICLE the price was scraped from, not anywhere
+// the person could actually go. This looks up an actual nearby branch of
+// the identified chain and returns its real address + a maps link to it.
+async function verifyNearbyStation(env, chain, location, radius) {
+  if (!env.FOURSQUARE_API_KEY || !chain || !location) return null;
+  try {
+    const radiusMeters = Math.min(100000, Math.round(radius * 1609)); // miles -> meters, Foursquare caps ~100km
+    const params = new URLSearchParams({ query: chain, near: location, radius: String(radiusMeters), limit: "1" });
+    const res = await fetch(`https://places-api.foursquare.com/places/search?${params.toString()}`, {
+      headers: {
+        Authorization: `Bearer ${env.FOURSQUARE_API_KEY}`,
+        "X-Places-Api-Version": "2025-06-17",
+        accept: "application/json"
+      }
+    });
+    if (!res.ok) return null;
+    const data = await res.json();
+    const place = data && Array.isArray(data.results) && data.results[0];
+    if (!place) return null;
+    const address = place.location && (place.location.formatted_address || place.location.address);
+    const mapsUrl = (typeof place.latitude === "number" && typeof place.longitude === "number")
+      ? `https://www.google.com/maps/search/?api=1&query=${place.latitude},${place.longitude}`
+      : null;
+    return { address: address || null, mapsUrl };
+  } catch (err) {
+    return null;
+  }
+}
+
+// Plain (unverified) Google Maps search link — the last-resort "somewhere
+// to actually go" when neither the chain's own domain nor Foursquare
+// turned anything up. Still a real place search, never the source article.
+function mapsSearchUrl(query) {
+  return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query)}`;
+}
